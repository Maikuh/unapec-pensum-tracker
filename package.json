{
	"name": "unapec-pensum-tracker",
	"version": "2.3.8",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check",
		"typecheck": "tsc --noEmit",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"test": "vitest",
		"test:all": "vitest run && playwright test",
		"test:coverage": "vitest run --coverage",
		"test:coverage:ui": "vitest --ui --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:install": "playwright install --with-deps chromium",
		"test:run": "vitest run",
		"test:ui": "vitest --ui",
		"sync:pensums": "bun scripts/sync-pensums.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@dagrejs/dagre": "^3.1.3",
		"@xyflow/react": "^12.12.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"html-to-image": "^1.11.13",
		"lucide-react": "^1.70.0",
		"next": "^16.4.5",
		"next-themes": "^0.4.6",
		"posthog-js": "^1.447.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@playwright/test": "^1.65.0",
		"@tailwindcss/postcss": "^4.3.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/bun": "^1.4.4",
		"@types/node": "24",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"@vitest/coverage-istanbul": "^5.1.0",
		"@vitest/ui": "^5.1.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"cheerio": "^1.2.0",
		"jsdom": "^31.0.0",
		"shadcn": "^4.23.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^7",
		"vitest": "^5.1.0"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	],
	"engines": {
		"node": ">=24.15.0 <25 || >=26.0.0 <27",
		"bun": ">=1.3.5"
	},
	"browserslist": [
		">0.3%",
		"not dead",
		"not op_mini all",
		"not ie 11"
	]
